{
  "package": "@carbon/react",
  "theming": "Import '@carbon/react/scss/index' (or '@carbon/react' compiled CSS) for the default theme. Themes are g10 (light), g90/g100 (dark) via @carbon/themes. Apps styled with the Airtable layer also import src/theme.scss once, globally; it re-points Carbon's --cds-* tokens at the --at-* tokens below.",
  "categories": [
    {
      "name": "color",
      "guidance": "Use Carbon color tokens (e.g. --cds-background, --cds-text-primary, --cds-border-subtle) or, in Airtable-styled apps, the --at-* tokens listed under 'airtable'. Never hardcode hex values, rgb()/hsl() colors or inline styles.",
      "reference": "https://carbondesignsystem.com/elements/color/overview/"
    },
    {
      "name": "spacing",
      "guidance": "Use Carbon's spacing scale ($spacing-01 through $spacing-13 in Sass), the 2x Grid, or the --at-space-* tokens under 'airtable'. No raw px values except 0 and 1px hairlines; use rem for sizes that are not spacing.",
      "reference": "https://carbondesignsystem.com/elements/spacing/overview/"
    },
    {
      "name": "typography",
      "guidance": "Use Carbon type tokens/mixins (e.g. type.heading-03, type.body-01) instead of hardcoded font-size/line-height/letter-spacing.",
      "reference": "https://carbondesignsystem.com/elements/typography/overview/"
    }
  ],
  "airtable": {
    "source": "higherwave/apptest1 src/theme.scss and src/tokens.scss (DESIGN.md plus Signal Flow additions). Every hex is defined once in theme.scss; pages and component styles reference only var(--at-*) or var(--cds-*).",
    "rules": [
      "No hex, rgb() or hsl() values, and no inline style props, in page code. Put styling in a CSS Module (*.module.scss) that uses tokens.",
      "No raw px except 0 and 1px hairlines. Use --at-space-* for spacing, --at-radius-* for corners, and the role() type mixin from tokens.scss for text.",
      "Use --at-radius-pill only for the pricing sub-system. Tags and tabs use --at-radius-md or --at-radius-sm.",
      "One primary Button per view."
    ],
    "color": {
      "text": [
        {
          "token": "--at-ink",
          "use": "Primary text, headings"
        },
        {
          "token": "--at-body",
          "use": "Body text on the page"
        },
        {
          "token": "--at-muted",
          "use": "Secondary text, descriptions"
        },
        {
          "token": "--at-text-tertiary",
