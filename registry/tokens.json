    "pxToSpace": {
      "note": "Nearest token for the px values the Signal Flow prototype uses. Ties round down. Values of 56px or more are layout sizes: use rem, Grid or flex, not spacing tokens. 1px hairlines stay literal.",
      "map": {
        "2": "--at-space-xxs",
        "3": "--at-space-xxs",
        "4": "--at-space-xxs",
        "5": "--at-space-xxs",
        "6": "--at-space-xs",
        "8": "--at-space-xs",
        "10": "--at-space-sm",
        "12": "--at-space-sm",
        "13": "--at-space-sm",
        "14": "--at-space-md",
        "15": "--at-space-md",
        "16": "--at-space-md",
        "18": "--at-space-md",
        "20": "--at-space-md",
        "22": "--at-space-lg",
        "24": "--at-space-lg",
        "28": "--at-space-xl",
        "32": "--at-space-xl",
        "40": "--at-space-xl",
        "44": "--at-space-xxl",
        "48": "--at-space-xxl"
      }
    },
    "pxToType": {
      "note": "Font sizes in the prototype mapped to type roles. 28px page titles are a design call between title-lg and display-md.",
      "map": {
        "11": "meta",
        "12": "meta",
        "13": "body-md",
        "14": "body-md",
        "15": "label-md",
        "16": "label-md",
        "17": "title-sm",
        "18": "title-sm",
        "20": "title-md",
        "22": "title-lg",
        "24": "title-lg",
        "28": "display-md",
        "32": "display-md",
        "40": "display-lg"
      }
    },
