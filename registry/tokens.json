          "token": "--at-canvas",
          "use": "Page and card surface"
        },
        {
          "token": "--at-surface-soft",
          "use": "Subtle panel fill"
        },
        {
          "token": "--at-surface-strong",
          "use": "Strong neutral fill, gray badges, progress track"
        },
        {
          "token": "--at-surface-hover",
          "use": "Row and button hover"
        },
        {
          "token": "--at-surface-hover-strong",
          "use": "Nav row hover"
        },
        {
          "token": "--at-surface-dark",
          "use": "Dark surface"
        },
        {
          "token": "--at-surface-dark-elevated",
