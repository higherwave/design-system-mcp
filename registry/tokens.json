          "token": "button-sm",
          "use": "14px: in-app actions"
        },
        {
          "token": "body-md",
          "use": "14px: body text"
        },
        {
          "token": "caption",
          "use": "14px, 0.16px tracking: section labels, uppercase"
        },
        {
          "token": "meta",
          "use": "12px: status lines, table headers, badges"
        }
      ]
